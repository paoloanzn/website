{
  "name": "website",
  "version": "2.0.0",
  "private": true,
  "description": "Personal site and blog of Paolo Anzani.",
  "author": "Paolo Anzani <paoloanzn@gmail.com>",
  "license": "MIT",
  "scripts": {
    "dev": "eleventy --serve --port 1000",
    "build": "eleventy",
    "clean": "rm -rf _site",
