---
layout: layouts/base.njk
title: Start here
permalink: /start-here/
---
<h1>Start here</h1>

{% set posts = collections.post | featuredPosts(featured) %}

{% if posts.length %}
    <p>A few pieces worth reading first.</p>
    <div class="post-abbrev-featured-container">
        {% for post in posts %}
            <div class="post-abbrev-featured-body">
                {% if post.image %}
                    <div class="post-abbrev-featured-img">
                        <a href="{{ post.url }}"><img class="dither" src="{{ post.image }}" alt="" /></a>
                    </div>
                {% endif %}
                <div class="post-abbrev-date">{{ post.date | readableDate }}</div>
                <div class="post-abbrev-link"><a href="{{ post.url }}">{{ post.data.title | apostrophy | markdown | safe }}</a></div>
                <div class="post-abbrev-read-time">{{ post.content | readTime }}</div>
            </div>
        {% endfor %}
    </div>
{% else %}
    <div class="empty-state">
        <p>There's nothing to feature yet &#8212; no posts have been written.</p>
        <p>
            Once there are some, list them in <code>_data/featured.json</code> and
            they'll show up here.
        </p>
    </div>
{% endif %}
